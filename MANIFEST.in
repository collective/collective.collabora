graft src/collective
graft docs
prune docs/_build
exclude docs/conf.py
exclude docs/Makefile
include *.rst
exclude *.txt
exclude .github
exclude *.yaml
exclude Makefile
exclude tox.ini
global-exclude *.pyc
include .coveragerc
include base.cfg
recursive-include news *.gitkeep *.breaking *.feature *.bugfix *.internal
prune docker
